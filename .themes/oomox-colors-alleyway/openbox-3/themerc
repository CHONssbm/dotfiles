# Menu
menu.border.color: #c3c3c3

menu.title.bg: Solid Flat
menu.title.bg.color: #101112
menu.title.bg.shadow: 0
menu.title.text.color: #c3c3c3
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #101112
menu.items.text.color: #c3c3c3
menu.items.disabled.text.color: #969696

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #6E6765
menu.items.active.text.color: #c3c3c3

menu.separator.color: #969696
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 4

# Window focused
window.active.title.separator.color: #101112

# Active window
window.active.border.color: #6E6765


window.active.title.bg: flat solid
window.active.title.bg.color: #101112
window.active.title.separator.color: #101112
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #c3c3c3

window.active.handle.bg: flat solid
window.active.handle.bg.color: #101112

window.active.grip.bg: flat solid
window.active.grip.bg.color: #101112

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #101112
window.active.button.unpressed.image.color: #c3c3c3

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #6E6765
window.active.button.pressed.image.color: #101112

window.active.button.disabled.bg: flat solid
window.active.button.disabled.bg.color: #101112
window.active.button.disabled.image.color: #969696

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #101112
window.active.button.hover.image.color: #6E6765

#window.active.button.toggled.bg: #6E6765
#window.active.button.toggled.image.color: #101112

# Inactive window
window.inactive.border.color: #101112

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #101112
window.inactive.title.separator.color: #101112
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #969696

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #101112

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #101112

window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #101112
window.inactive.button.unpressed.image.color: #969696

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #6E6765
window.inactive.button.pressed.image.color: #101112

window.inactive.button.disabled.bg: flat solid
window.inactive.button.disabled.bg.color: #969696
window.inactive.button.disabled.image.color: #101112

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #101112
window.inactive.button.hover.image.color: #6E6765


# OSD
osd.border.width: 1
osd.border.color: #6E6765

osd.bg: flat solid
osd.bg.color: #101112
osd.label.bg: flat solid
osd.label.bg.color: #101112
osd.label.text.color: #c3c3c3

# OSD
osd.bg: Solid Flat
osd.bg.color: #101112
osd.bg.shadow: 0

osd.border.width: 2
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #6E6765
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #101112

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #907569
#osd.button.unpressed.*.border.color: #c3c3c3

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #6E6765
#osd.button.pressed.*.border.color: #101112

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #c3c3c3
#osd.button.focused.*.border.color: #101112

osd.button.focused.box.color: #6E6765


# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
menu.title.text.font:shadow=n


# Everything else
border.width: 3
padding.width: 8
padding.height: 3
window.handle.width: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0
