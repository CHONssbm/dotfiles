# Menu
menu.border.color: #c1c1c1

menu.title.bg: Solid Flat
menu.title.bg.color: #0a0a07
menu.title.bg.shadow: 0
menu.title.text.color: #c1c1c1
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #0a0a07
menu.items.text.color: #c1c1c1
menu.items.disabled.text.color: #939392

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #2d7b87
menu.items.active.text.color: #c1c1c1

menu.separator.color: #939392
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 4

# Window focused
window.active.title.separator.color: #0a0a07

# Active window
window.active.border.color: #2d7b87


window.active.title.bg: flat solid
window.active.title.bg.color: #0a0a07
window.active.title.separator.color: #0a0a07
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #c1c1c1

window.active.handle.bg: flat solid
window.active.handle.bg.color: #0a0a07

window.active.grip.bg: flat solid
window.active.grip.bg.color: #0a0a07

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #0a0a07
window.active.button.unpressed.image.color: #c1c1c1

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #2d7b87
window.active.button.pressed.image.color: #0a0a07

window.active.button.disabled.bg: flat solid
window.active.button.disabled.bg.color: #0a0a07
window.active.button.disabled.image.color: #939392

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #0a0a07
window.active.button.hover.image.color: #2d7b87

#window.active.button.toggled.bg: #2d7b87
#window.active.button.toggled.image.color: #0a0a07

# Inactive window
window.inactive.border.color: #0a0a07

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #0a0a07
window.inactive.title.separator.color: #0a0a07
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #939392

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #0a0a07

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #0a0a07

window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #0a0a07
window.inactive.button.unpressed.image.color: #939392

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #2d7b87
window.inactive.button.pressed.image.color: #0a0a07

window.inactive.button.disabled.bg: flat solid
window.inactive.button.disabled.bg.color: #939392
window.inactive.button.disabled.image.color: #0a0a07

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #0a0a07
window.inactive.button.hover.image.color: #2d7b87


# OSD
osd.border.width: 1
osd.border.color: #2d7b87

osd.bg: flat solid
osd.bg.color: #0a0a07
osd.label.bg: flat solid
osd.label.bg.color: #0a0a07
osd.label.text.color: #c1c1c1

# OSD
osd.bg: Solid Flat
osd.bg.color: #0a0a07
osd.bg.shadow: 0

osd.border.width: 2
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #2d7b87
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #0a0a07

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #935f31
#osd.button.unpressed.*.border.color: #c1c1c1

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #2d7b87
#osd.button.pressed.*.border.color: #0a0a07

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #c1c1c1
#osd.button.focused.*.border.color: #0a0a07

osd.button.focused.box.color: #2d7b87


# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
menu.title.text.font:shadow=n


# Everything else
border.width: 3
padding.width: 8
padding.height: 3
window.handle.width: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0
