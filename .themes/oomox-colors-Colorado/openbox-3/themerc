# Menu
menu.border.color: #c0c5ca

menu.title.bg: Solid Flat
menu.title.bg.color: #05182B
menu.title.bg.shadow: 0
menu.title.text.color: #c0c5ca
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #05182B
menu.items.text.color: #c0c5ca
menu.items.disabled.text.color: #9199a2

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #10609F
menu.items.active.text.color: #c0c5ca

menu.separator.color: #9199a2
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 4

# Window focused
window.active.title.separator.color: #05182B

# Active window
window.active.border.color: #10609F


window.active.title.bg: flat solid
window.active.title.bg.color: #05182B
window.active.title.separator.color: #05182B
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #c0c5ca

window.active.handle.bg: flat solid
window.active.handle.bg.color: #05182B

window.active.grip.bg: flat solid
window.active.grip.bg.color: #05182B

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #05182B
window.active.button.unpressed.image.color: #c0c5ca

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #10609F
window.active.button.pressed.image.color: #05182B

window.active.button.disabled.bg: flat solid
window.active.button.disabled.bg.color: #05182B
window.active.button.disabled.image.color: #9199a2

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #05182B
window.active.button.hover.image.color: #10609F

#window.active.button.toggled.bg: #10609F
#window.active.button.toggled.image.color: #05182B

# Inactive window
window.inactive.border.color: #05182B

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #05182B
window.inactive.title.separator.color: #05182B
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #9199a2

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #05182B

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #05182B

window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #05182B
window.inactive.button.unpressed.image.color: #9199a2

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #10609F
window.inactive.button.pressed.image.color: #05182B

window.inactive.button.disabled.bg: flat solid
window.inactive.button.disabled.bg.color: #9199a2
window.inactive.button.disabled.image.color: #05182B

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #05182B
window.inactive.button.hover.image.color: #10609F


# OSD
osd.border.width: 1
osd.border.color: #10609F

osd.bg: flat solid
osd.bg.color: #05182B
osd.label.bg: flat solid
osd.label.bg.color: #05182B
osd.label.text.color: #c0c5ca

# OSD
osd.bg: Solid Flat
osd.bg.color: #05182B
osd.bg.shadow: 0

osd.border.width: 2
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #10609F
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #05182B

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #0377C9
#osd.button.unpressed.*.border.color: #c0c5ca

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #10609F
#osd.button.pressed.*.border.color: #05182B

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #c0c5ca
#osd.button.focused.*.border.color: #05182B

osd.button.focused.box.color: #10609F


# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
menu.title.text.font:shadow=n


# Everything else
border.width: 3
padding.width: 8
padding.height: 3
window.handle.width: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0
