
{
    "layer": "top",
    "spacing": 5,
    "height": 5,

    "modules-left": [
        "custom/exit",
        "custom/wallpaper",
        "hyprland/window"
    ],
    "modules-center": [
        "hyprland/workspaces",
    ],
    "modules-right": [
        "pulseaudio",
        "custom/weather",
        "tray",
        "clock"
    ],

    "pulseaudio": {
        "tooltip": false,
        "scroll-step": 5,
        "format": "{icon}    {volume}%",
        "format-muted": "Muted",
        "on-click": "pavucontrol",
        "format-icons": {
            "default": [
                "",
                "",
                ""
            ]
        }
    },

    "hyprland/workspaces": {
      "all-outputs": true,
      "on-click": "activate",
      "sort-by-number": false,
      "format": "{icon}",
      "icon-size": 24,
      "format-icons": {
          "active": "",
          "default": ""
        },
      "persistent_workspaces": {
          "*": 4
      }
    },

    "hyprland/window": {
  "format": "{}",
  "rewrite": {
    "(.*) - Mozilla Firefox": "🌎 $1",
    "(.*) - zsh": "> [$1]"
  }
},

    "network": {
        "format-wifi": "{essid} ({signalStrength}%)",
        "format-ethernet": " ",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "Disconnected ⚠",
        "tooltip": false
    },

    "backlight": {
        "tooltip": false,
        "format": " {}%",
        "interval": 1,
        "on-scroll-up": "light -A 5",
        "on-scroll-down": "light -U 5"
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "{icon}  {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{time} {icon}",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    "clock": {
        "interval": 1,
        "format": "{:%a %d %b  ○  %I:%M %p}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
          "mode"          : "year",
          "mode-mon-col"  : 3,
          "weeks-pos"     : "right",
          "on-scroll"     : 1,
          "on-click-right": "mode",
          "format": {
            "months":     "<span color='#ffead3'><b>{}</b></span>",
            "days":       "<span color='#ecc6d9'><b>{}</b></span>",
            "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
            "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
          }
        },
        "actions": {
          "on-click-right": "mode",
          "on-click-forward": "tz_up",
          "on-click-backward": "tz_down",
          "on-scroll-up": "shift_up",
          "on-scroll-down": "shift_down"
        }
      },

    "cpu": {
        "interval": 15,
        "format": "   {}%",
        "max-length": 10,
        "on-click": "kitty -e btop"
    },

    "memory": {
        "interval": 30,
        "format": "   {}%",
        "max-length": 10,
        "tooltip": true,
        "on-click": "kitty -e btop"
    },

    "custom/keybinds": {
      "format": "",
      "exec": "~/.config/waybar/scripts/main.lua",
      "interval": 999999,
      "tooltip-format": "{}",
    },

    "custom/wallpaper": {
        "format": " ",
        "on-click": "kitty ~/bash-scripts/wallpaper.sh",
        "tooltip": true,
        "tooltip-format": "Wallpaper Script"
    },

    "custom/weather": {
      "format": "{}°",
      "tooltip": true,
      "interval": 3600,
      "exec": "wttrbar --nerd --fahrenheit --location Denver",
      "return-type": "json",
    },

    "custom/backlight": {
        "format": "{}",
        "tooltip-format": "{}",
        "escape": true,
        "return-type": "json",
        "exec": "~/shared-across/dotfiles/scripts/get-brightness.sh",
        "restart-interval": 10,
        "tooltip": false
    },

    "custom/exit": {
        "format": "",
        "on-click": "kitty sudo shutdown now",
        "tooltip": false
    }
}
